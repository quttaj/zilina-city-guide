<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <title>User List</title>
    <%- include("includes/head.ejs") %> 
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        .table td, .table th {
            padding: 0.5rem; 
            vertical-align: middle; 
        }
        .icon-button {
            border: none;
            background: none;
            color: inherit;
            display: flex; 
            align-items: center; 
            justify-content: center; 
            width: 40px; 
            height: 40px; 
        }
        .action-cell { 
            display: flex;
            gap: 10px; 
            justify-content: center; 
        }
    </style>
</head>

<%- include("includes/header.ejs") %> 
<body>
    <div class="container mt-4">
        <h1>User List</h1>
        <hr class="featurette-divider">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">First Name</th>
                    <th scope="col">Last Name</th>
                    <th scope="col">Email</th>

                </tr>
            </thead>
            <tbody>
                <% users.forEach((user, index) => { %>
                    <tr>
                        <th scope="row"><%= index + 1 %></th>
                        <td><%= user.first_name %></td>
                        <td><%= user.last_name %></td>
                        <td><%= user.email %></td>
                        <td class="action-cell">
                            <a href="/admin/user/<%= user.id %>/edit" class="icon-button" aria-label="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form method="post" action="/admin/user/<%= user.id %>/delete" style="display: inline-block;">
                                <button type="submit" class="icon-button" aria-label="Delete">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
<%- include("includes/footer.ejs") %> 

</html>
