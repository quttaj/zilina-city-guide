<html lang="en" data-bs-theme="light">

<head>
    <title>List</title>
    <%- include("includes/head.ejs") %>
</head>
   
<%- include("includes/header.ejs") %>

<% function truncate(str, num) {
    if (str.length > num) {
        return str.slice(0, num) + "...";
    } else {
        return str;
    }
} %>

<body>
    <div class="album py-5 bg-body-tertiary">
        <h2 class="pb-2 border-bottom text-center">Gallery</h2>
        <div class="container">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                <% places.forEach(function(place) { %>
                    <div class="col">
                        <div class="card shadow-sm">
                            <% if (place.image_path) { %>
                                
                                <img class="bd-placeholder-img card-img-top" src="<%= place.image_path %>" width="100%" height="225" alt="Image of <%= place.name %>">
                            <% } else { %>
                                <svg class="bd-placeholder-img card-img-top" width="100%" height="225" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Placeholder: Thumbnail" preserveAspectRatio="xMidYMid slice" focusable="false">
                                    <rect width="100%" height="100%" fill="#55595c"></rect>
                                </svg>
                            <% } %>
                            <div class="card-body">
                                <h5 class="card-title"><%= place.name %></h5>
                                <p class="card-text"><%= truncate(place.description, 100) %></p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="btn-group">
                                        <a href="/place/<%= encodeURIComponent(place.name) %>" class="btn btn-sm btn-outline-secondary">View</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                <% }); %>
            </div>
        </div>
    </div>
    
    
</body>

<%- include("includes/footer.ejs") %>

</html>